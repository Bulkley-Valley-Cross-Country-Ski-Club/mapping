              <placement repeatDistance="0" polygonPlacementFlags="2" allowDegraded="0" distUnits="MM" xOffset="0" geometryGeneratorType="PointGeometry" preserveRotation="1" dist="0" priority="10" maximumDistance="0" quadOffset="4" offsetUnits="MapUnit" lineAnchorPercent="0.5" predefinedPositionOrder="TR,TL,BR,BL,R,L,TSR,BSR" yOffset="0" overrunDistance="0" layerType="LineGeometry" maxCurvedCharAngleIn="25" centroidWhole="0" rotationAngle="0" lineAnchorTextPoint="CenterOfText" repeatDistanceMapUnitScale="3x:0,0,0,0,0,0" overrunDistanceMapUnitScale="3x:0,0,0,0,0,0" distMapUnitScale="3x:0,0,0,0,0,0" geometryGeneratorEnabled="0" placementFlags="9" centroidInside="0" overlapHandling="PreventOverlap" overrunDistanceUnit="MM" lineAnchorType="0" maximumDistanceMapUnitScale="3x:0,0,0,0,0,0" offsetType="0" repeatDistanceUnits="MapUnit" labelOffsetMapUnitScale="3x:0,0,0,0,0,0" lineAnchorClipping="0" geometryGenerator="" prioritization="PreferCloser" maximumDistanceUnit="MM" placement="2" fitInPolygonOnly="0" rotationUnit="AngleDegrees" maxCurvedCharAngleOut="-25"/>
              <rendering upsidedownLabels="0" limitNumLabels="0" fontMaxPixelSize="10000" fontLimitPixelSize="0" mergeLines="0" unplacedVisibility="0" drawLabels="1" scaleVisibility="1" obstacleFactor="2" obstacle="1" obstacleType="0" zIndex="0" fontMinPixelSize="3" maxNumLabels="2000" scaleMin="0" scaleMax="10000" minFeatureSize="0" labelPerPart="0"/>
              <dd_properties>
                <Option type="Map">
                  <Option value="" name="name" type="QString"/>
                  <Option name="properties" type="Map">
                    <Option name="MaximumScale" type="Map">
                      <Option value="true" name="active" type="bool"/>
                      <Option value="-- see max scale dependency rule for explanation of what's going on here&#xd;&#xa;if (regexp_match(coalesce(@layout_name, 'Print'), '^Print') > 0,&#xd;&#xa;&#x9;if(&#xd;&#xa;&#x9;&#x9;coalesce(&quot;INSET_HINT&quot;, 0) = 2,&#xd;&#xa;&#x9;&#x9;0,&#xd;&#xa;&#x9;&#x9;if(&#xd;&#xa;&#x9;&#x9;&#x9;within(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;$geometry,&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;geometry(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;get_feature('Inset Extent', 'id', 0)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;)&#xd;&#xa;&#x9;&#x9;&#x9;)&#xd;&#xa;&#x9;&#x9;&#x9;OR&#xd;&#xa;&#x9;&#x9;&#x9;coalesce(&quot;INSET_HINT&quot;, 0) = 1,&#xd;&#xa;&#x9;&#x9;&#x9;0,&#xd;&#xa;&#x9;&#x9;&#x9;10000&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;0&#xd;&#xa;)" name="expression" type="QString"/>
                      <Option value="3" name="type" type="int"/>
                    </Option>
                    <Option name="MinimumScale" type="Map">
                      <Option value="true" name="active" type="bool"/>
                      <Option value="if (regexp_match(coalesce(@layout_name, 'Print'), '^Print') > 0,&#x9;-- only manage scale-dependency in a Print layout or default view (on screen) i.e. not Digital layout&#xd;&#xa;&#x9;if(&#xd;&#xa;&#x9;&#x9;coalesce(&quot;INSET_HINT&quot;, 0) = 2,&#x9;-- INSET_HINT = 2 means always show this label regardless of scale&#xd;&#xa;&#x9;&#x9;0,&#x9;-- 0 meaning no max scale constraint&#xd;&#xa;&#x9;&#x9;if(&#xd;&#xa;&#x9;&#x9;&#x9;within(&#x9;-- is feature entirely contained by the inset map, as represented by the Inset Extent layer?&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;$geometry,&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;geometry(&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;get_feature('Inset Extent', 'id', 0)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;)&#xd;&#xa;&#x9;&#x9;&#x9;)&#xd;&#xa;&#x9;&#x9;&#x9;OR&#xd;&#xa;&#x9;&#x9;&#x9;coalesce(&quot;INSET_HINT&quot;, 0) = 1,&#x9;-- has a hint been provided to say that even though the feature is not entirely contained it should still be only shown in the inset&#xd;&#xa;&#x9;&#x9;&#x9;10000,&#x9;-- 10000 is the max scale at which to display this label&#xd;&#xa;&#x9;&#x9;&#x9;0 -- 0 meaning no max scale constraint&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;),&#xd;&#xa;&#x9;0&#x9;-- no max scale constraint when not in Print layout or default view (i.e. not Digital layout)&#xd;&#xa;)" name="expression" type="QString"/>
                      <Option value="3" name="type" type="int"/>
                    </Option>
                    <Option name="RepeatDistance" type="Map">
                      <Option value="true" name="active" type="bool"/>
                      <Option value="LBL_REPEAT" name="field" type="QString"/>
                      <Option value="2" name="type" type="int"/>
                    </Option>
                    <Option name="ScaleVisibility" type="Map">
                      <Option value="false" name="active" type="bool"/>
                      <Option value="if(&#xd;&#xa;&#x9;within(&#xd;&#xa;&#x9;&#x9;$geometry,&#xd;&#xa;&#x9;&#x9;geometry(&#xd;&#xa;&#x9;&#x9;&#x9;get_feature('Inset Extent', 'id', 0)&#xd;&#xa;&#x9;&#x9;)&#xd;&#xa;&#x9;) OR &quot;INSET_HINT&quot; = 'Yes',&#xd;&#xa;&#x9;1,&#xd;&#xa;&#x9;0&#xd;&#xa;)" name="expression" type="QString"/>
                      <Option value="3" name="type" type="int"/>
                    </Option>
                  </Option>
                  <Option value="collection" name="type" type="QString"/>
                </Option>
              </dd_properties>
              <callout type="simple">
