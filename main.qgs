      <labeling type="rule-based">
        <rules key="{821b07f3-f24a-4cad-8e9c-ad364226af32}">
          <rule description="All Trails" key="{a58ad588-008d-4b3d-bac5-e47faf3a9cfe}">
            <settings calloutType="simple">
              <text-style textColor="0,0,0,255,rgb:0,0,0,1" fontWordSpacing="0" allowHtml="0" previewBkgrdColor="255,255,255,255,rgb:1,1,1,1" isExpression="1" fontLetterSpacing="0" useSubstitutions="0" fontSize="7.75" fontStrikeout="0" blendMode="0" forcedItalic="0" tabStopDistanceMapUnitScale="3x:0,0,0,0,0,0" tabStopDistanceUnit="Point" fontFamily=".AppleSystemUIFont" multilineHeightUnit="Percentage" fontUnderline="0" fontWeight="50" fontSizeUnit="Point" multilineHeight="1" tabStopDistance="80" fontItalic="0" capitalization="0" textOpacity="1" legendString="Aa" forcedBold="0" fontKerning="1" textOrientation="horizontal" fieldName="with_variable('CLOSED_TEXT', case when coalesce(&quot;CLOSED&quot;, 0) = 1 then '|(CLOSED)' else '' end,&#xa;    case&#xd;&#xa;&#x9;    when regexp_match(coalesce(@layout_name, 'Print'), '^Digital$') > 0 then&#xd;&#xa;&#x9;&#x9;    if(round($length / 1000, 1) > 0.1, concat(&quot;TRAIL_NAME&quot;, '|', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT), null)&#xd;&#xa;&#x9;    else&#xd;&#xa;&#x9;&#x9;&#x9;case&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 0 then&#x9;-- no label&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;null&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 1 then&#x9;-- trail name&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat(&quot;TRAIL_NAME&quot;, @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 2 then&#x9;-- trail name, new line, distance&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat(&quot;TRAIL_NAME&quot;, '|', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 3 then&#x9;-- trail name, (abbreviation), new line, distance&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat(&quot;TRAIL_NAME&quot;, ' (', regexp_replace(regexp_replace(&quot;TRAIL_NAME&quot;, '\\B[a-z]', ''), '\\s', ''), ')', '|', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 4 then&#x9;-- abbreviation, new line, distance&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat(regexp_replace(regexp_replace(&quot;TRAIL_NAME&quot;, '\\B[a-z]', ''), '\\s', ''), '|', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 5 then&#x9;-- distance&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat(max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 6 then&#x9;-- new line, distance&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat('|', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 7 then&#x9;-- trail name, distance [no new line]&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat(&quot;TRAIL_NAME&quot;, ' ', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;when &quot;LBL_SCHEME&quot; = 8 then&#x9;-- new line, trail name, new line, distance&#xd;&#xa;&#x9;&#x9;&#x9;&#x9;&#x9;concat('|', &quot;TRAIL_NAME&quot;, '|', max(round($length / 1000, 1), 0.1), 'km', @CLOSED_TEXT)&#xd;&#xa;&#x9;&#x9;&#x9;end&#xd;&#xa;    end&#xa;)" fontSizeMapUnitScale="3x:0,0,0,0,0,0" namedStyle="">
                <families/>
                <text-buffer bufferBlendMode="0" bufferOpacity="0.80000000000000004" bufferDraw="1" bufferSizeMapUnitScale="3x:0,0,0,0,0,0" bufferSizeUnits="MM" bufferNoFill="0" bufferColor="255,255,255,255,rgb:1,1,1,1" bufferSize="1" bufferJoinStyle="128"/>
                <text-mask maskJoinStyle="128" maskOpacity="1" maskType="0" maskSizeMapUnitScale="3x:0,0,0,0,0,0" maskSizeUnits="MM" maskEnabled="0" maskSize="1.5" maskSize2="1.5" maskedSymbolLayers=""/>
                <background shapeBorderWidth="0" shapeOpacity="1" shapeSizeX="0" shapeOffsetUnit="MM" shapeOffsetMapUnitScale="3x:0,0,0,0,0,0" shapeRadiiMapUnitScale="3x:0,0,0,0,0,0" shapeRadiiX="0" shapeRadiiY="0" shapeDraw="0" shapeType="3" shapeRotationType="0" shapeSizeType="0" shapeSVGFile="" shapeRotation="0" shapeFillColor="51,160,44,255,rgb:0.20000000000000001,0.62745098039215685,0.17254901960784313,1" shapeOffsetX="0" shapeBorderColor="128,128,128,255,rgb:0.50196078431372548,0.50196078431372548,0.50196078431372548,1" shapeJoinStyle="64" shapeSizeMapUnitScale="3x:0,0,0,0,0,0" shapeBorderWidthMapUnitScale="3x:0,0,0,0,0,0" shapeSizeY="0" shapeBorderWidthUnit="MM" shapeRadiiUnit="MM" shapeOffsetY="0" shapeSizeUnit="MM" shapeBlendMode="0">
